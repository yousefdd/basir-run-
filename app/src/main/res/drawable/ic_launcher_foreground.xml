<!-- Basir-Run mark: a runner on a curving lane. Kept inside the 66 dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Lane edges, warm yellow fading to amber towards the horizon -->
    <path
        android:pathData="M16,88 C20,62 34,44 50,28 M92,88 C88,62 76,44 62,28"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="88"
                android:endX="56" android:endY="28"
                android:startColor="#FFFFD54A"
                android:endColor="#FFF59E0B" />
        </aapt:attr>
    </path>
    <!-- Running line down the middle of the lane -->
    <path
        android:pathData="M54,76 L55.6,73 M57.6,69 L58.8,65.5 M60,61.5 L60.8,57.5 M61.4,52.5 L61.6,48 M61.5,43 L61.1,38.5 M60.7,34.5 L60.3,31.5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#FF19C3B4"
        android:fillColor="#00000000" />
    <!-- Runner -->
    <path
        android:pathData="M50,39 m-5.5,0 a5.5,5.5 0,1 0,11 0 a5.5,5.5 0,1 0,-11 0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M48,47 L43,61 M47,50 L53,55 L57,50 M46,50 L40,54 L36,50 M43,61 L51,67 L50,78 M43,61 L38,70 L30,72"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000" />
</vector>
